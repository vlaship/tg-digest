# Secrets for docker compose. Copy this file to .env and fill it in:
#     Copy-Item .env.example .env
# .env is in .gitignore — never commit it.
# Each value overrides the same setting in data/config.toml. Leave a value empty
# to keep the one from config.toml.

# From https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=

# The phone number of the account that follows the channels, international format
TG_PHONE=

# From https://console.anthropic.com
ANTHROPIC_API_KEY=
