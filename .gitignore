/target

# Cargo.lock is committed: it pins glass_pumpkin 2.0.0-rc0 (see AGENTS.md),
# without this pin the build breaks

# The working config has API keys and the phone number — only
# config.example.toml goes into the repository
config.toml

# Telegram session file = FULL ACCESS TO THE ACCOUNT. Never commit it.
tg.session
tg.session-journal
tg.session-wal
tg.session-shm
*.session

# Container volume: config.toml, tg.session and the database are also here
/data

# Database: channels, cursors, journal of runs and digest parts
*.db
*.db-journal
*.db-wal
*.db-shm

# Dry-run output
/out
/logs
